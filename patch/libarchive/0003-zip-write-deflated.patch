+/*
+ * Take the current entry's data as one finished raw deflate stream,
+ * compressed by the caller, instead of compressing it here. The caller
+ * supplies what this writer would otherwise have computed: the CRC-32
+ * and the length of the uncompressed data. Call it once, after
+ * archive_write_header and in place of archive_write_data. With a
+ * stream made by the same zlib at the same settings (raw deflate,
+ * window 15, memLevel 8, default strategy, the writer's level) the
+ * archive is byte-for-byte what archive_write_data would have written,
+ * which is what lets a caller compress members on several threads.
+ *
+ * Declared here rather than in archive.h: this is one caller's entry
+ * point, and a change to archive.h recompiles the whole library.
+ */
+int archive_write_zip_data_deflated(struct archive *, const void *,
+    size_t, unsigned long, la_int64_t);
+
+int
+archive_write_zip_data_deflated(struct archive *_a, const void *buff,
+    size_t s, unsigned long crc, la_int64_t uncompressed_size)
+{
+	struct archive_write *a = (struct archive_write *)_a;
+	struct zip *zip;
+	int ret;
+
+	archive_check_magic(_a, ARCHIVE_WRITE_MAGIC, ARCHIVE_STATE_DATA,
+		"archive_write_zip_data_deflated");
+	if (a->archive.archive_format != ARCHIVE_FORMAT_ZIP) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		"Can only use archive_write_zip_data_deflated"
+		" with zip format");
+		return (ARCHIVE_FATAL);
+	}
+	zip = a->format_data;
+	if (zip->entry_compression != COMPRESSION_DEFLATE
+	    || zip->entry_encryption != ENCRYPTION_NONE
+	    || zip->entry_deflated
+	    || zip->entry_compressed_written != 0
+	    || zip->entry_uncompressed_written != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Entry cannot take deflated data");
+		return (ARCHIVE_FAILED);
+	}
+	ret = __archive_write_output(a, buff, s);
+	if (ret != ARCHIVE_OK)
+		return (ret);
+	zip->entry_compressed_written += s;
+	zip->written_bytes += s;
+	zip->entry_uncompressed_written = uncompressed_size;
+	zip->entry_uncompressed_limit = 0;
+	zip->entry_crc32 = (uint32_t)crc;
+	zip->entry_deflated = 1;
+	return (ARCHIVE_OK);
+}
